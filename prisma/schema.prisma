generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  OWNER
  STAFF
  CUSTOMER
}
enum Condition {
  NEW
  UK_USED
  REFURBISHED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}
model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role @default(CUSTOMER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  sessions Session[]
  resets PasswordReset[]
  addresses Address[]
  orders Order[]
  carts Cart[]
  audits AuditLog[]
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
model PasswordReset {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  products Product[]
}
model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  brand String
  description String
  specifications Json @default("{}")
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  featured Boolean @default(false)
  archived Boolean @default(false)
  demo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  variants ProductVariant[]
  images ProductImage[]
}
model ProductVariant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  sku String @unique
  storage String?
  color String
  condition Condition
  batteryHealth Int?
  price Int
  discountPrice Int?
  inventory Inventory?
  orderItems OrderItem[]
  cartItems CartItem[]
}
model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String
  publicId String @unique
  alt String
  position Int @default(0)
}
model Inventory {
  variantId String @id
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int @default(0)
  reserved Int @default(0)
  updatedAt DateTime @updatedAt
}
model Cart {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  tokenHash String @unique
  expiresAt DateTime
  items CartItem[]
}
model CartItem {
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id])
  quantity Int
  @@id([cartId, variantId])
}
model Address {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  phone String
  line1 String
  city String
  region String
  country String @default("GH")
}
model Order {
  id String @id @default(cuid())
  reference String @unique
  trackingTokenHash String @unique
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  email String
  shippingAddress Json
  subtotal Int
  deliveryFee Int
  total Int
  currency String @default("GHS")
  paymentStatus PaymentStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  deliveryInfo String?
  reservationExpiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items OrderItem[]
  payments Payment[]
  @@index([createdAt])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id])
  name String
  sku String
  quantity Int
  unitPrice Int
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id])
  reference String @unique
  providerId String? @unique
  amount Int
  currency String @default("GHS")
  status PaymentStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt DateTime @default(now())
}
model WebhookEvent {
  id String @id
  processedAt DateTime @default(now())
}
model StoreSettings {
  id String @id @default("store")
  businessName String @default("TINO APPLE HUB")
  logoUrl String?
  brandColor String @default("#2563eb")
  currency String @default("GHS")
  whatsapp String?
  contactEmail String?
  contactPhone String?
  address String?
  deliveryFee Int @default(0)
  shippingZones Json @default("[]")
  socialLinks Json @default("{}")
  seo Json @default("{}")
  updatedAt DateTime @updatedAt
}
model Content {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id])
  action String
  entityId String
  metadata Json @default("{}")
  createdAt DateTime @default(now())
}
model RateLimit {
  key String @id
  count Int @default(1)
  resetAt DateTime
}
